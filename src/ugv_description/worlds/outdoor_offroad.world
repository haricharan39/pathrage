<?xml version="1.0"?>
<!--
  outdoor_offroad - Phase 0 test world.

  Textured ground (model://terrain_textured, found via GAZEBO_MODEL_PATH which
  gazebo.launch.py sets) + sun + a few static obstacles + a goal marker at 10 m.

  The textured ground matters: stereo matching and ORB-SLAM3 need visual features.
  A flat grey ground_plane makes tracking fail in Phase 1.

  Start the robot at (0,0), facing +X. Obstacles are at least 0.15 m high so the depth
  obstacle layer (Phase 3) treats them as real obstacles.
-->
<sdf version="1.7">
  <world name="outdoor_offroad">

    <include><uri>model://sun</uri></include>
    <include><uri>model://terrain_textured</uri></include>

    <model name="rock_1">
      <static>true</static>
      <pose>3 1 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
          <material><ambient>0.45 0.43 0.40 1</ambient><diffuse>0.45 0.43 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>5 -1.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>7.5 2.0 0.2 0 0 -0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material><ambient>0.55 0.50 0.42 1</ambient><diffuse>0.55 0.50 0.42 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Goal marker for Point A -> Point B tests (visual only, no collision) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>10 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.10 0.90 0.20 1</ambient><diffuse>0.10 0.90 0.20 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
