<?xml version="1.0"?>
<!--
  Off-road outdoor world stub for the UGV visual navigation project.

  Build order (see the software-only build plan in /docs):
    1. Start with just the ground plane + sun + a handful of simple
       obstacle boxes/cylinders standing in for rocks -- get Nav2 driving
       against the depth-only costmap first.
    2. Add uneven terrain (a heightmap) once the flat-ground version works.
    3. Add denser obstacles / narrower gaps for stress-testing TEB and the
       segmentation model later.

  TODO: swap the placeholder box/cylinder obstacles below for a heightmap
  terrain plugin and rock/vegetation models (e.g. from the Gazebo model
  database) once the basic pipeline is verified end-to-end.
-->
<sdf version="1.7">
  <world name="outdoor_offroad">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Placeholder obstacles -- replace/add more as scenarios get harder -->
    <model name="rock_1">
      <static>true</static>
      <pose>3 1 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>5 -1.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <!-- Goal marker for Point A -> Point B testing (visual only, no collision) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>10 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
