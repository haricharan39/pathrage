<?xml version="1.0"?>
<!--
  UGV model for the vision-based outdoor navigation project (SIH PS 26126).

  Design decisions this file encodes (see /docs for the full write-up):
    - Single fixed, forward-facing stereo camera + IMU (no pan-tilt, no 360deg rig)
    - Differential-drive chassis (swap for Ackermann here later if the real
      hardware ends up being a proper car-steered base instead of skid-steer)

  TODO: replace placeholder box/cylinder geometry with real meshes once the
  actual chassis dimensions are known; the collision/inertial values below
  are rough placeholders for early Gazebo testing, not final numbers.
-->
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_length" value="0.50"/>
  <xacro:property name="chassis_width"  value="0.35"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="wheel_radius"   value="0.08"/>
  <xacro:property name="wheel_width"    value="0.04"/>

  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Wheels (skid-steer, 4x) ===================== -->
  <xacro:macro name="wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin rpy="1.5708 0 0"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_offset="0.18"  y_offset="0.20"/>
  <xacro:wheel prefix="front_right" x_offset="0.18"  y_offset="-0.20"/>
  <xacro:wheel prefix="rear_left"   x_offset="-0.18" y_offset="0.20"/>
  <xacro:wheel prefix="rear_right"  x_offset="-0.18" y_offset="-0.20"/>

  <!-- ===================== Stereo camera + IMU mount ===================== -->
  <!-- Single fixed, forward-facing mount -- rigidly bolted, no rotating parts. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.10 0.03"/></geometry>
    </visual>
  </link>

  <joint name="chassis_to_camera" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <!-- mounted at the front, slightly tilted down to see near-field ground -->
    <origin xyz="${chassis_length/2} 0 0.08" rpy="0 0.15 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="camera_to_imu" type="fixed">
    <parent link="camera_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo plugins ===================== -->
  <!-- TODO: fill in gazebo_ros_camera (stereo pair) + gazebo_ros_imu_sensor
       plugin blocks here once the target Gazebo version (Classic vs
       Fortress/Ignition) is finalized -- the plugin SDF differs between them. -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="stereo_camera">
      <!-- placeholder: configure stereo baseline, resolution, and
           frame rate to match the intended real sensor (e.g. RealSense D435i) -->
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <!-- placeholder: set update rate + noise model -->
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- placeholder: wheel joints, separation, diameter, /cmd_vel topic -->
    </plugin>
  </gazebo>

</robot>
