<?xml version="1.0"?>
<sdf version="1.6">
  <model name="terrain_textured">
    <static>true</static>
    <link name="link">
      <!-- Same friction as Gazebo's stock ground_plane, so driving behaviour is unchanged. -->
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>200 200</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh><uri>model://terrain_textured/meshes/ground.obj</uri></mesh>
        </geometry>
        <material>
          <script>
            <uri>model://terrain_textured/materials/scripts</uri>
            <uri>model://terrain_textured/materials/textures</uri>
            <name>Terrain/Ground</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
