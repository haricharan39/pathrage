<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2 integration for the UGV visual navigation project (SIH PS 26126):
    Nav2 parameter configuration (NavFn A* global planner, MPPI local controller,
    obstacle points from the vision pipeline) and the top-level full_stack launch
    file tying sim + stereo depth + mapping + vision + navigation together.
  </description>
  <maintainer email="you@example.com">Hari Charan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>stereo_image_proc</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_vision</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
