+void StereoSlamNode::PublishPose(const Sophus::SE3f &Tcw, const builtin_interfaces::msg::Time &stamp)
+{
+    const int state = m_SLAM->GetTrackingState();
+    const bool ok = (state == 2);   // ORB_SLAM3::Tracking::OK
+
+    std_msgs::msg::Int32 state_msg;
+    state_msg.data = state;
+    state_pub->publish(state_msg);
+
+    std_msgs::msg::Bool ok_msg;
+    ok_msg.data = ok;
+    ok_pub->publish(ok_msg);
+
+    RCLCPP_INFO_THROTTLE(this->get_logger(), *this->get_clock(), 2000,
+                         "tracking state=%d keypoints=%zu", state, m_SLAM->GetTrackedKeyPointsUn().size());
+
+    // No pose while tracking is not OK: Tcw is stale or the identity then.
+    if (!ok)
+        return;
+
+    // ORB-SLAM3 returns Tcw (world -> camera). Publish its inverse Twc (camera in the world).
+    const Sophus::SE3f Twc = Tcw.inverse();
+    const Eigen::Vector3f t = Twc.translation();
+    const Eigen::Quaternionf q = Twc.unit_quaternion();
+    if (!t.allFinite() || !q.coeffs().allFinite())
+        return;
+
+    geometry_msgs::msg::PoseStamped msg;
+    msg.header.stamp = stamp;            // same stamp as the image pair
+    msg.header.frame_id = "orb_map";
+    msg.pose.position.x = t.x();
+    msg.pose.position.y = t.y();
+    msg.pose.position.z = t.z();
+    msg.pose.orientation.x = q.x();
+    msg.pose.orientation.y = q.y();
+    msg.pose.orientation.z = q.z();
+    msg.pose.orientation.w = q.w();
+    pose_pub->publish(msg);
+}
